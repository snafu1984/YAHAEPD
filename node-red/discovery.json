    {
        "id": "function_discovery",
        "type": "function",
        "z": "8dff866cf5fdd88d",
        "name": "Generate 20 Discovery Messages",
        "func": "let rows = [1, 2, 3, 4, 5];\nlet cols = [\"A\", \"B\", \"C\", \"D\"];\n\nlet messages = [];\n\nfor (let r of rows) {\n    for (let c of cols) {\n\n        let id = `display_${c.toLowerCase()}${r}`;\n\n        messages.push({\n            topic: `homeassistant/sensor/${id}/config`,\n            payload: JSON.stringify({\n                name: `Display ${c}${r}`,\n                object_id: id,\n                unique_id: id,\n                state_topic: `Display/${c}${r}`,\n                icon: \"mdi:card-text\",\n                force_update: true,\n                device: {\n                    identifiers: [\"display_matrix\"],\n                    name: \"Display Matrix\",\n                    manufacturer: \"NodeRed\",\n                    model: \"5x4 MQTT Display\"\n                }\n            }),\n            retain: true,\n            qos: 1\n        });\n    }\n}\n\nreturn [messages];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
