    {
        "id": "88758a64623e9a23",
        "type": "function",
        "z": "8dff866cf5fdd88d",
        "name": "Wochentag",
        "func": "let n = msg.total;\nvar i=0;\nif(n>i) \n{\n    var dow=msg.payload[i].eventStart;\n    dow = new Date(dow).getDay();\n    switch (dow)\n    {\n        case 0:\n        dow = 'So';\n        break;\n        \n        case 1:\n        dow = 'Mo';\n        break;\n        \n        case 2:\n        dow = 'Di';\n        break;\n        \n        case 3:\n        dow = 'Mi';\n        break;\n        \n        case 4:\n        dow = 'Do';\n        break;\n        \n        case 5:\n        dow = 'Fr';\n        break;\n        \n        case 6:\n        dow = 'Sa';\n        break;\n        \n        default:\n        dow = '--';\n        break;\n    }\n\nmsg.payload = dow;}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
